{
  "name": "@sudobility/sudojo_ui",
  "version": "0.0.1",
  "description": "Shared Sudoku game UI components for Sudojo",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@sudobility/sudojo_lib": ">=0.0.151",
    "@sudobility/sudojo_types": ">=1.2.56",
    "@sudobility/components": ">=5.0.71",
    "@sudobility/design": ">=1.1.30",
    "@heroicons/react": ">=2.0.0",
    "react-i18next": ">=14.0.0",
    "i18next": ">=23.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "~5.9.3",
    "@sudobility/sudojo_lib": "^0.0.151",
    "@sudobility/sudojo_types": "^1.2.56",
    "@sudobility/components": "^5.0.72",
    "@sudobility/design": "^1.1.30",
    "@heroicons/react": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "i18next": "^26.3.1"
  },
  "license": "BUSL-1.1"
}
